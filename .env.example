COMPOSE_PROJECT_NAME=fds
# ---------------------------------------------------------------------------
# FDS Business — variables d'environnement (Docker Compose + Laravel)
# Copier en .env (make init génère les secrets). Ne jamais versionner .env.
# ---------------------------------------------------------------------------

# Compose
HOST_UID=1000
HOST_GID=1000
FDS_IMAGE_TAG=local
PHP_BUILD_TARGET=base
APP_DOMAIN=localhost

# Application
APP_NAME="FDS Business"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5173
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=debug

# Base de données (MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fds
DB_USERNAME=fds
DB_PASSWORD=__GENERATE__
DB_ROOT_PASSWORD=__GENERATE__

# Redis (files, cache, sessions)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Sessions : expiration après 240 min d'inactivité (CDC §4.1)
SESSION_DRIVER=redis
SESSION_COOKIE=fds_session
SESSION_LIFETIME=240
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost

# Mots de passe : Argon2id (D-005)
HASH_DRIVER=argon2id

# Fichiers privés
FILESYSTEM_DISK=private

# PDF (Gotenberg)
GOTENBERG_URL=http://gotenberg:3000

# E-mail (Mailpit en développement)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@fds-business.local"
MAIL_FROM_NAME="${APP_NAME}"
