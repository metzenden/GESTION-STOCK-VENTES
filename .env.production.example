# Modèle de production (L8-02) : remplacer gestion.example.com, les valeurs __…__ et générer les secrets (make init).
COMPOSE_PROJECT_NAME=fds
# ---------------------------------------------------------------------------
# FDS Business — variables d'environnement (Docker Compose + Laravel)
# Copier en .env (make init génère les secrets). Ne jamais versionner .env.
# ---------------------------------------------------------------------------

# Compose
HOST_UID=1000
HOST_GID=1000
FDS_IMAGE_TAG=local
PHP_BUILD_TARGET=prod
APP_DOMAIN=gestion.example.com

# Application
APP_NAME="FDS Business"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gestion.example.com
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
FRONTEND_URL=https://gestion.example.com

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=warning

# Base de données (MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fds
DB_USERNAME=fds
DB_PASSWORD=__GENERATE__
DB_ROOT_PASSWORD=__GENERATE__

# Redis (files, cache, sessions)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Sessions : expiration après 240 min d'inactivité (CDC §4.1)
SESSION_DRIVER=redis
SESSION_COOKIE=fds_session
SESSION_LIFETIME=240
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=gestion.example.com

# Mots de passe : Argon2id (D-005)
HASH_DRIVER=argon2id

# Fichiers privés
FILESYSTEM_DISK=private

# PDF (Gotenberg)
GOTENBERG_URL=http://gotenberg:3000

# E-mail (Mailpit en développement)
MAIL_MAILER=smtp
MAIL_HOST=__SMTP_HOST__
MAIL_PORT=587
MAIL_USERNAME=__SMTP_USER__
MAIL_PASSWORD=__SMTP_PASSWORD__
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Limitation de débit de l'API (requêtes par minute et par utilisateur, L7-03)
API_RATE_LIMIT=600

# Sauvegardes restic (L8-03) : dépôt externe chiffré (S3 compatible, SFTP…)
RESTIC_REPOSITORY=__s3:https://stockage.example.com/fds-backups__
RESTIC_PASSWORD=__GENERATE__
AWS_ACCESS_KEY_ID=__KEY__
AWS_SECRET_ACCESS_KEY=__SECRET__
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12

# Supervision (L8-04) : destinataire des alertes
ALERT_EMAIL=__exploitation@example.com__
